# Load Testing Environment Configuration
#
# Copy this file to .env.loadtest and configure for your environment:
#   cp .env.loadtest.example .env.loadtest
#
# Then load it before running tests:
#   source .env.loadtest

# ============================================================================
# API Configuration
# ============================================================================

# Base URL of the API to test
# Local: http://localhost:8000 (will be auto-converted to host.docker.internal)
# Remote: https://staging.easyhooks.io or https://api.easyhooks.io
LOADTEST_API_BASE_URL=http://localhost:8000

# Admin token for creating test tenants
# Get this from your .env file (ADMIN_SEED_TOKEN) or generate a new one
LOADTEST_ADMIN_TOKEN=change-this-to-your-admin-seed-token

# ============================================================================
# Tenant Configuration
# ============================================================================

# Number of test tenants to create
# Baseline tests: 50 tenants
# Throughput tests: 100+ tenants
# Multi-tenant tests: 15+ tenants (different groups)
LOADTEST_TENANT_COUNT=50

# Prefix for tenant names (helps identify test tenants)
# Will create tenants like: loadtest-tenant-0001, loadtest-tenant-0002, etc.
LOADTEST_TENANT_PREFIX=loadtest

# Path to tenant pool file (relative to load_tests/)
# This file is auto-generated and contains tenant credentials
LOADTEST_TENANT_POOL_FILE=.tenant_pool.json

# ============================================================================
# Locust Configuration
# ============================================================================

# Number of Locust worker processes
# More workers = more load generation capacity
# Recommended: 2 for baseline, 4+ for high load tests
LOADTEST_WORKERS=2

# Test scenario to run
# Options: baseline, throughput, websocket_scale, multi_tenant, stress
LOADTEST_SCENARIO=baseline

# ============================================================================
# WebSocket Configuration
# ============================================================================

# WebSocket connection timeout (seconds)
# How long to wait when establishing WebSocket connection
LOADTEST_WS_TIMEOUT=10

# WebSocket receive timeout (seconds)
# How long to wait for messages on WebSocket
LOADTEST_WS_RECEIVE_TIMEOUT=5

# ============================================================================
# Metrics & Observability
# ============================================================================

# Enable custom metrics collection
# Set to false to reduce overhead during very high load tests
LOADTEST_ENABLE_CUSTOM_METRICS=true

# Interval to export metrics (seconds)
# Lower values = more granular data but higher overhead
LOADTEST_METRICS_EXPORT_INTERVAL=10

# ============================================================================
# Advanced Configuration
# ============================================================================

# Healthcheck configuration
# Maximum retries when waiting for API to be ready
MAX_RETRIES=60

# Interval between health check retries (seconds)
RETRY_INTERVAL=2

# ============================================================================
# Usage Examples
# ============================================================================
#
# 1. Local testing (default):
#    source .env.loadtest
#    ./run-loadtest.sh baseline
#
# 2. Test against staging:
#    export LOADTEST_API_BASE_URL=https://staging.easyhooks.io
#    export LOADTEST_ADMIN_TOKEN=<staging-token>
#    ./run-loadtest.sh throughput --tenant-count 100
#
# 3. High load test with more workers:
#    export LOADTEST_WORKERS=8
#    ./run-loadtest.sh stress
#
# 4. Using Makefile shortcuts:
#    make loadtest-local        # baseline test
#    make loadtest-throughput   # throughput test
#    make loadtest-validate     # validate environment only
