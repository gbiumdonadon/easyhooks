# Load testing (k6) — optional overrides
#
# Copy to .env.loadtest and source before running scripts, or rely on repo root .env
# (LOADTEST_ADMIN_TOKEN can match ADMIN_SEED_TOKEN).

LOADTEST_API_BASE_URL=http://localhost:8000
LOADTEST_ADMIN_TOKEN=change-this-to-your-admin-seed-token

LOADTEST_TENANT_COUNT=50
LOADTEST_TENANT_PREFIX=loadtest
TENANT_POOL_FILE=.tenant_pool.json

# k6 scenario tuning (see k6/scenarios/*.js)
K6_TARGET_RPS=150
K6_DURATION=3m
K6_PREALLOC_VUS=80
K6_MAX_VUS=400
K6_WS_VUS=80
K6_CUSTOM_TARGET=30
K6_CUSTOM_SLEEP=0.2

MAX_RETRIES=60
RETRY_INTERVAL=2
