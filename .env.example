# =============================================================================
# EasyHooks — Environment Variables
# =============================================================================
# Copy this file to .env and replace all placeholder values before running.
# Never commit the actual .env file to version control.
#
# Generate secure random values with:
#   Linux/macOS/WSL:  openssl rand -hex 32
#   PowerShell:       [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://webhooks:change-this-password@db:5432/webhooks?sslmode=disable
POSTGRES_USER=webhooks
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=webhooks

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_WEBHOOK_TOPIC=webhooks.inbound
KAFKA_DLQ_TOPIC=webhooks.dlq
KAFKA_CONSUMER_GROUP=webhook-workers

# -----------------------------------------------------------------------------
# Security — MUST change before running in any shared/production environment
# -----------------------------------------------------------------------------
# Bootstrap token for the admin API. Set once and keep secret.
ADMIN_SEED_TOKEN=change-this-to-a-secure-random-token

# Signing key for WebSocket short-lived tokens (HMAC-SHA256).
APP_SECRET_KEY=change-this-to-a-secure-random-key

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_BASE_MS=100
IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
WS_TOKEN_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Redis Pub/Sub & Streams
# -----------------------------------------------------------------------------
TENANT_EVENTS_CHANNEL_PREFIX=tenant_events:
TENANT_EVENTS_STREAM_PREFIX=stream:tenant:
STREAM_MAX_LEN=1000
STREAM_HISTORY_COUNT=50

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# -----------------------------------------------------------------------------
# Tenant Secrets
# -----------------------------------------------------------------------------
SECRET_KEY_BYTES=32

# -----------------------------------------------------------------------------
# Observability — OpenTelemetry / Jaeger
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=easyhooks
METRICS_ENABLED=true
TRACING_ENABLED=true
# Reduce to 0.1 in production to lower overhead
TRACING_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Grafana — MUST change GRAFANA_ADMIN_PASSWORD before exposing externally
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GRAFANA_SERVER_ROOT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Go runtime
# -----------------------------------------------------------------------------
# GOMAXPROCS defaults to the number of available CPU cores — no action needed
# for typical deployments. Override only in constrained environments (e.g. containers
# with fractional CPU limits): GOMAXPROCS=2

# -----------------------------------------------------------------------------
# Load Testing (load_tests/ only — not used by the main application)
# -----------------------------------------------------------------------------
# Set to the same value as ADMIN_SEED_TOKEN when running load tests locally
LOADTEST_ADMIN_TOKEN=change-this-to-your-admin-seed-token
LOADTEST_API_BASE_URL=http://localhost:8000
