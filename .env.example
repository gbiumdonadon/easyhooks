# =============================================================================
# EasyHooks — Environment Variables
# =============================================================================
# Copy this file to .env and replace all placeholder values before running.
# Never commit the actual .env file to version control.
#
# Generate secure random values with:
#   Linux/macOS/WSL:  openssl rand -hex 32
#   PowerShell:       [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# =============================================================================

# -----------------------------------------------------------------------------
# Capacity profile (drives memory-related defaults)
# -----------------------------------------------------------------------------
# EASYHOOKS_PROFILE=small|medium|large|custom
#   small  — recommended for ~256MB containers (GOMEMLIMIT=200MiB)
#   medium — recommended for ~512MB containers (GOMEMLIMIT=450MiB)
#   large  — recommended for ~1GB   containers (GOMEMLIMIT=900MiB)
#   custom — disables tier defaults; you must set every memory-related env
#            below explicitly.
#
# Any individual env var (REDIS_POOL_SIZE, STREAM_MAX_LEN, INGEST_MAX_QUEUE_DEPTH,
# WS_FANOUT_BUFFER_SIZE) overrides the profile. Set to 0 = treated as "not
# set" → profile default wins.
#
# See "Capacity planning" in README.md for the measured RPS / WS / latency per
# profile.
EASYHOOKS_PROFILE=small

# -----------------------------------------------------------------------------
# Redis (sole datastore — admin/tenant credentials, idempotency, streams)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# REDIS_POOL_SIZE  — leave unset to use profile default (small=50, medium=100,
# large=200). Override only if you know what you are doing.
# REDIS_POOL_SIZE=100

# -----------------------------------------------------------------------------
# Security — MUST change before running in any shared/production environment
# -----------------------------------------------------------------------------
# Bootstrap token for the admin API. Set once and keep secret.
ADMIN_SEED_TOKEN=change-this-to-a-secure-random-token

# Signing key for WebSocket short-lived tokens (HMAC-SHA256).
APP_SECRET_KEY=change-this-to-a-secure-random-key

# -----------------------------------------------------------------------------
# Event work-queue (Redis Streams)
# -----------------------------------------------------------------------------
EVENT_STREAM_KEY=events:in
DLQ_STREAM_KEY=events:failed
CONSUMER_GROUP=webhook-workers
STREAM_BLOCK_MS=5000
STREAM_COUNT=32

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_BASE_MS=100
IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# WebSocket / per-tenant fan-out streams
# -----------------------------------------------------------------------------
WS_TOKEN_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=300
TENANT_EVENTS_STREAM_PREFIX=stream:tenant:
# STREAM_MAX_LEN — leave unset to use profile default (small=1000, medium=5000,
# large=10000). Caps each per-tenant stream's history.
# STREAM_MAX_LEN=1000
STREAM_HISTORY_COUNT=50
# WS_USE_FANOUT — when true, a single XREAD goroutine per tenant feeds every
# WS subscriber via the fanout layer (recommended). Set to false to fall back
# to one XREAD per WS connection (higher Redis pressure under many clients).
WS_USE_FANOUT=true
# WS_FANOUT_BUFFER_SIZE — buffered channel size per WS subscriber. Slow
# subscribers whose buffer fills are dropped (see websocket_subscriber_dropped_total).
# Leave unset to use profile default (small=100, medium=256, large=512).
# WS_FANOUT_BUFFER_SIZE=100

# -----------------------------------------------------------------------------
# Load shedding (HTTP 429 on saturated ingestion queue)
# -----------------------------------------------------------------------------
# INGEST_MAX_QUEUE_DEPTH — high watermark on XLEN(events:in). Above it the API
# rejects new POST /v1/webhooks/* with 429 + Retry-After. Leave unset to use
# profile default (small=5000, medium=25000, large=50000).
# INGEST_MAX_QUEUE_DEPTH=5000
# QUEUE_DEPTH_POLL_MS — how often the API samples XLEN to refresh the atomic
# counter consulted by the hot path.
QUEUE_DEPTH_POLL_MS=1000
# QUEUE_DEPTH_LOW_WATER_PCT — hysteresis. Once shedding engages, it only
# releases when depth drops to (high * pct / 100). Default 80% prevents
# flapping between 429s and 202s.
QUEUE_DEPTH_LOW_WATER_PCT=80

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# -----------------------------------------------------------------------------
# Tenant secret generation
# -----------------------------------------------------------------------------
SECRET_KEY_BYTES=32

# -----------------------------------------------------------------------------
# Observability — OpenTelemetry / Jaeger (optional, only used by monitoring stack)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=easyhooks
METRICS_ENABLED=true
TRACING_ENABLED=true
# Reduce to 0.1 in production to lower overhead
TRACING_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Grafana — only used by docker-compose.monitoring.yml
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GRAFANA_SERVER_ROOT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Go runtime
# -----------------------------------------------------------------------------
# GOMAXPROCS defaults to the number of available CPU cores — no action needed
# for typical deployments. Override only in constrained environments (e.g. containers
# with fractional CPU limits): GOMAXPROCS=2
#
# GOMEMLIMIT (advanced override) — when set, takes precedence over the profile
# default. EasyHooks logs which one is in effect at startup.
# Example: GOMEMLIMIT=450MiB

# -----------------------------------------------------------------------------
# Load Testing (load_tests/ only — not used by the main application)
# -----------------------------------------------------------------------------
# Set to the same value as ADMIN_SEED_TOKEN when running load tests locally
LOADTEST_ADMIN_TOKEN=change-this-to-your-admin-seed-token
LOADTEST_API_BASE_URL=http://localhost:8000
